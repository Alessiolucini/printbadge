# Copia questo file in ".env" e compila i valori.
# Indirizzo del tuo Supabase self-hosted e chiave service_role (SEGRETA: resta solo su questo computer).
SUPABASE_URL=https://supabase.printbadge.com
SUPABASE_SERVICE_ROLE_KEY=la-tua-chiave-service-role

# Nome della stampante come la vede il sistema: "npm run printers" li elenca tutti.
PRINTER_NAME=EVOLIS_Badgy100

# Opzioni del driver passate a ogni stampa (macOS/Linux, comando lp).
# Per vedere quelle della tua stampante: lpoptions -p NOME_STAMPANTE -l
PRINT_OPTIONS=-o PageSize=Card
PRINT_OPTIONS_PORTRAIT=-o Orientation=PORTRAIT
PRINT_OPTIONS_LANDSCAPE=-o Orientation=LANDSCAPE_CC90

# Nome di questo computer nei log degli ordini e ogni quanti secondi controllare.
AGENT_NAME=ufficio-stampa
POLL_SECONDS=10

# true = prova: scarica gli ordini e mostra il comando senza stampare (non spreca card).
DRY_RUN=false

# Solo Windows: percorso di SumatraPDF, usato per stampare i PDF senza aprire finestre.
# SUMATRA_PATH=C:\Program Files\SumatraPDF\SumatraPDF.exe
