<?xml version="1.0" encoding="UTF-8"?>
<!-- Avvio automatico su macOS. Sostituisci /PERCORSO/agent con la cartella dell'agente, poi:
     cp com.printbadge.agent.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.printbadge.agent.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.printbadge.agent</string>
  <key>WorkingDirectory</key><string>/PERCORSO/agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>--env-file=.env</string>
    <string>printbadge-agent.mjs</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/PERCORSO/agent/agent.log</string>
  <key>StandardErrorPath</key><string>/PERCORSO/agent/agent.log</string>
</dict>
</plist>
