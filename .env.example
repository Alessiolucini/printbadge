# Copia in .env.production (o imposta queste variabili nel tuo hosting) prima di "npm run build".
# Indirizzo pubblico del tuo Supabase self-hosted e chiave pubblica "anon" (mai la service_role!).
VITE_SUPABASE_URL=https://supabase.badgeok.com
VITE_SUPABASE_ANON_KEY=la-tua-chiave-anon

# Pagine legali mostrate nel checkout (condizioni di vendita e privacy).
VITE_TERMS_URL=https://badgeok.com/condizioni.html
VITE_PRIVACY_URL=https://badgeok.com/privacy.html
